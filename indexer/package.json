{
  "name": "streamfi-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/worker.js",
    "dev": "tsx src/worker.ts",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0"
  }
}
